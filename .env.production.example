# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - MATERIA PRIMA BACKEND
# Servidor: https://avances.cuadrambc.com
# Frontend: https://avances-mbc.netlify.app
# ==============================================================================

NODE_ENV=production
PORT=3000
SERVER_HOST=0.0.0.0

# Debe ser 'true' porque corre detrás del proxy reverso / SSL (Nginx, Traefik, Cloudflare, etc.)
TRUST_PROXY=true

# Conexión a la base de datos de producción MySQL
# Reemplaza con las credenciales y host reales de tu servidor MySQL
DATABASE_URL="mysql://usuario_prod:password_seguro@localhost:3306/avance_material"

# CORS: Origen autorizado de la PWA en Netlify (sin diagonal final)
CORS_ORIGINS=https://avances-mbc.netlify.app

# Políticas de sesión y tokens
SESSION_DURATION_DAYS=30
ACCESS_TOKEN_EXPIRES_MINUTES=15
SESSION_REFRESH_INTERVAL_HOURS=24

# Cookies cross-site para comunicación entre Netlify y avances.cuadrambc.com:
# OBLIGATORIO para producción con dominios diferentes:
# - Secure: true (requiere HTTPS en el backend)
# - SameSite: none (permite que la cookie HttpOnly viaje desde el frontend de Netlify hacia la API)
SESSION_COOKIE_NAME=mp_session
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# Secretos criptográficos (Generar valores aleatorios seguros de 32+ caracteres)
JWT_SECRET=02c9ecef42ed38c0c1c9c52052cf1095dfebe2011fe11e1be268a3a9138c36676b1ec3dc2db3884fb39481b1fe2b5ca88df87e462c99a75593161b8e0b86fa59
PASSWORD_ENCRYPTION_KEY=e7b8c6f4a2d1e0f9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5
