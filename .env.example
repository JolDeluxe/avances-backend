# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# Seguridad & Proxy
# Activar 'true' si corre detrás de Nginx, Traefik, AWS ALB, Cloudflare, etc.
TRUST_PROXY=false

# CORS (Orígenes separados por coma). En producción incluir la URL de Netlify:
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://avances-mbc.netlify.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# BASE DE DATOS (MySQL)
# ==========================================
DATABASE_URL="mysql://usuario:password@localhost:3306/materia_prima_db"
