    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
